# Optional LAN exposure with basic auth. The app itself binds 127.0.0.1:8000
# (kiosk localhost only); Caddy fronts it on :8080 for LAN browsers.
#
# Generate the password hash once:
#   caddy hash-password --plaintext 'your-password'
# then start with the hash in the environment:
#   COCKPIT_BASIC_AUTH_HASH='$2a$14$...' caddy run --config deploy/Caddyfile

:8080 {
	basic_auth {
		pi {env.COCKPIT_BASIC_AUTH_HASH}
	}
	reverse_proxy 127.0.0.1:8000
}
