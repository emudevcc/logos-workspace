# Copy to .env in the app directory (create once). Empty values disable a feature.
LLM_API_KEY=
DEEPGRAM_API_KEY=

# Local Whisper (offline STT): set STT_PROVIDER=whisper and run a whisper.cpp server.
# STT_PROVIDER=deepgram
# WHISPER_BASE_URL=http://localhost:8080

# HTTPS (see deploy/macos/certs.sh) — serve over TLS so mic/clipboard work on the LAN.
# HOST=0.0.0.0
# TLS_CERTFILE=deploy/certs/localhost.pem
# TLS_KEYFILE=deploy/certs/localhost-key.pem

# Optional tuning (uncomment to override defaults):
# LLM_DAILY_LIMIT=1000
# DEEPGRAM_DAILY_LIMIT=200
# RATE_LIMIT_PER_MINUTE=30
